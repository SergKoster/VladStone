APP_NAME="VladStone API"
ENVIRONMENT=local
API_PREFIX=/api
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
DATABASE_URL=postgresql+psycopg://vladstone:vladstone@postgres:5432/vladstone
REDIS_URL=redis://redis:6379/0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Callback, зарегистрированный в Google Cloud Console (прод: https://<домен>/api/auth/google/callback)
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/auth/google/callback
# Куда возвращать игрока после входа (прод: https://<домен>)
FRONTEND_URL=http://127.0.0.1:5173
# true на проде за HTTPS: куки только по защищённому соединению
COOKIE_SECURE=false
