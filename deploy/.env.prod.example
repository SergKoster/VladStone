# Скопируй в deploy/.env и заполни. Файл .env НЕ коммитится в git.

# ── Обязательное ────────────────────────────────────────────────
# Домен игры (на него уже должна указывать DNS A-запись VPS)
DOMAIN=play.example.com

# Пароль базы. Сгенерируй длинный случайный: openssl rand -hex 24
POSTGRES_PASSWORD=

# Google OAuth (docs/google-oauth.md). Redirect URI в Google Cloud Console:
# https://<DOMAIN>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://play.example.com/api/auth/google/callback
FRONTEND_URL=https://play.example.com

# ── Не менять без причины ───────────────────────────────────────
APP_NAME="VladStone API"
# production: выключает dev-login, email-коды в ответе и create_all
ENVIRONMENT=production
API_PREFIX=/api
# Куки только по HTTPS
COOKIE_SECURE=true
CORS_ORIGINS='["https://play.example.com"]'
# DATABASE_URL задаётся в docker-compose.prod.yml из POSTGRES_PASSWORD
